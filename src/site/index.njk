---
title: Barrrgh!
---

{% extends "layouts/_base.njk" %}
<!-- prettier-ignore -->
{% block styles %}
{{ super() }}
<style>
  /* The whole bar lights up when anything inside it (a chip OR the text field)
     is focused, so it reads as one unit filtering on ALL the chips. */
  #search-box:focus-within {
    box-shadow: 0 0 0 2px #94a3b8;
    border-color: #94a3b8;
  }
  #search-dropdown .opt {
    cursor: pointer;
  }
  #search-dropdown .opt:hover,
  #search-dropdown .opt.is-active {
    background: #f1f5f9;
  }
</style>
{% endblock %}
<!-- prettier-ignore -->
{% block body %}
<main class="flex flex-col items-center sm:mt-16">
  <div class="relative flex flex-col bg-white border-b border-t sm:border sm:rounded border-slate-200 sm:flex-initial sm:w-lg w-full pt-4 pb-8 px-8 sm:p-8">
    <img style="width: 15rem;" class="block sm:hidden absolute" src="/images/barrrgh-logo-ship.png" width="1741" height="858" alt="Barrrgh!" />
    <img style="width: 15rem; top: 2rem; left: 2.5rem" class="hidden sm:block absolute" src="/images/barrrgh-logo-ship.png" width="1741" height="858" alt="Barrrgh!" />
    <img class="w-20 sm:w-40 -mr-4 sm:mr-0 mt-16 sm:mt-0 self-end" src="/images/martin-the-pirate.png" width="1082" height="1164" alt="Martin the pirate smiling with a martini" />

    <div id="search-area" class="relative">
      <div class="absolute" style="top: -30px; left: 0;">
        <label for="search-input" class="text-slate-700">What would you like to drink?</label>
      </div>

      <div id="search-box" class="flex flex-wrap items-center gap-2 w-full rounded-sm border border-slate-300 bg-white px-3 py-2 cursor-text">
        <span id="chips" class="contents"></span>
        <input
          id="search-input"
          type="text"
          autocomplete="off"
          placeholder="Type a cocktail or ingredient"
          class="flex-1 border-none outline-none bg-transparent"
          style="min-width: 8rem;"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-dropdown"
          aria-autocomplete="list"
        />
      </div>

      <div id="search-dropdown" role="listbox" aria-label="Cocktail and ingredient suggestions" class="mt-1 rounded-sm border border-slate-200 bg-white overflow-hidden" style="display: none"></div>
    </div>

    <ul id="drinks-list" style="display: none"></ul>
    <h2 id="drinks-no-match" class="text-center" style="display: none">
      No drinks with all these ingredients ☠️
    </h2>
  </div>
</main>

<template id="drink-li-template">
  <li>
    <a href="#" class="block border-b border-slate-200 p-4 hover:bg-slate-100">
      <h2 data-drink-li-prop="drinkTitle"></h2>
      <div class="text-xs text-slate-700">
        <span data-drink-li-prop="ingredients"></span>
      </div>
    </a>
  </li>
</template>

<script id="ingredients-to-drinks-data" type="application/json">
  {{ collections.ingredientsToDrinks | dump | safe }}
</script>
<script id="drink-slugs-to-drinks-data" type="application/json">
  {{ collections.drinkSlugsToDrinks | dump | safe }}
</script>

<script>
  (function () {
    const ICON_COCKTAIL =
      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M4 4 L20 4 L12 13 Z"/><path d="M12 13 L12 20"/><path d="M8 20 L16 20"/></svg>';
    const ICON_INGREDIENT =
      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M12 5 L12 19"/><path d="M5 12 L19 12"/></svg>';
    const ICON_ARROW =
      '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M7 17 L17 7"/><path d="M8 7 L17 7 L17 16"/></svg>';

    const MAX_PER_GROUP = 8;

    // Manage traversing drinks data
    const DrinksData = function () {
      this.ingredientsToDrinks = JSON.parse(
        document.getElementById("ingredients-to-drinks-data").textContent
      );
      this.drinkSlugsToDrinks = JSON.parse(
        document.getElementById("drink-slugs-to-drinks-data").textContent
      );
      this.allIngredients = Object.keys(this.ingredientsToDrinks).sort();
    };

    DrinksData._intersection = function (setA, setB) {
      const result = new Set();
      for (const elem of setB) {
        if (setA.has(elem)) {
          result.add(elem);
        }
      }
      return result;
    };

    DrinksData.prototype.getDrinkBySlug = function (drinkSlug) {
      return this.drinkSlugsToDrinks[drinkSlug];
    };

    // Slugs of drinks that pass ALL given ingredients. With none, every drink passes.
    DrinksData.prototype.filterByIngredients = function (ingredients) {
      if (ingredients.length === 0) {
        return Object.keys(this.drinkSlugsToDrinks);
      }
      let matching = new Set(this.ingredientsToDrinks[ingredients[0]] || []);
      for (let i = 1; i < ingredients.length; i++) {
        matching = DrinksData._intersection(
          matching,
          new Set(this.ingredientsToDrinks[ingredients[i]] || [])
        );
      }
      return Array.from(matching);
    };

    DrinksData.prototype.matchCocktails = function (query, slugs) {
      return slugs
        .map((slug) => this.drinkSlugsToDrinks[slug])
        .filter((drink) => drink.drinkTitle.toLowerCase().includes(query))
        .sort((a, b) => a.drinkTitle.localeCompare(b.drinkTitle))
        .slice(0, MAX_PER_GROUP);
    };

    DrinksData.prototype.matchIngredients = function (query, excluded) {
      return this.allIngredients
        .filter((ing) => ing.includes(query) && !excluded.includes(ing))
        .slice(0, MAX_PER_GROUP);
    };

    // Manage the filtered results list below the search bar
    const DrinksList = function () {
      this.$drinksList = document.getElementById("drinks-list");
      this.$drinksNoMatch = document.getElementById("drinks-no-match");
      this.$itemTemplate = document.getElementById(
        "drink-li-template"
      ).content.firstElementChild;
    };

    DrinksList.prototype.createDrinkItemNode = function (drink) {
      const $item = this.$itemTemplate.cloneNode(true);
      const $anchor = $item.children[0];
      $anchor.href = drink.drinkUrl;
      $anchor.querySelector('[data-drink-li-prop="drinkTitle"]').innerText =
        drink.drinkTitle;
      $anchor.querySelector('[data-drink-li-prop="ingredients"]').innerText =
        drink.ingredients.join(", ");
      return $item;
    };

    DrinksList.prototype.hide = function () {
      this.$drinksNoMatch.style.display = "none";
      this.$drinksList.style.display = "none";
      this.$drinksList.replaceChildren();
    };

    DrinksList.prototype.renderDrinks = function (drinks) {
      this.$drinksNoMatch.style.display = "none";
      this.$drinksList.style.display = null;
      this.$drinksList.replaceChildren(
        ...drinks.map((drink) => this.createDrinkItemNode(drink))
      );
    };

    DrinksList.prototype.renderNoMatch = function () {
      this.$drinksList.style.display = "none";
      this.$drinksList.replaceChildren();
      this.$drinksNoMatch.style.display = null;
    };

    // Manage the search bar: chips, the type-ahead dropdown and its keyboard nav
    const UnifiedSearch = function (drinksData, drinksList) {
      this.drinksData = drinksData;
      this.drinksList = drinksList;
      this.selectedIngredients = [];

      // The dropdown's selectable rows, in display order, and which one is
      // highlighted for keyboard navigation (-1 = none).
      this.options = [];
      this.activeIndex = -1;

      this.$input = document.getElementById("search-input");
      this.$chips = document.getElementById("chips");
      this.$dropdown = document.getElementById("search-dropdown");
      this.$box = document.getElementById("search-box");
    };

    UnifiedSearch.prototype.renderChips = function () {
      this.$chips.replaceChildren();
      this.selectedIngredients.forEach((ingredient, index) => {
        const $chip = document.createElement("span");
        $chip.className =
          "inline-flex items-center gap-1 rounded-sm bg-slate-200 text-slate-700 text-sm pl-2 pr-1 py-0.5";
        $chip.textContent = ingredient;

        const $remove = document.createElement("button");
        $remove.type = "button";
        $remove.setAttribute("aria-label", "Remove " + ingredient);
        $remove.className =
          "leading-none text-slate-500 hover:text-slate-800 px-1";
        $remove.textContent = "×";
        $remove.addEventListener("click", (event) => {
          event.stopPropagation();
          this.removeIngredientAt(index);
        });

        $chip.appendChild($remove);
        this.$chips.appendChild($chip);
      });
    };

    UnifiedSearch.prototype.renderResults = function () {
      if (this.selectedIngredients.length === 0) {
        this.drinksList.hide();
        return;
      }
      const slugs = this.drinksData.filterByIngredients(this.selectedIngredients);
      if (slugs.length === 0) {
        this.drinksList.renderNoMatch();
        return;
      }
      this.drinksList.renderDrinks(
        slugs.map((slug) => this.drinksData.getDrinkBySlug(slug))
      );
    };

    UnifiedSearch.prototype.groupHeader = function (text) {
      const $el = document.createElement("div");
      $el.setAttribute("role", "presentation");
      $el.className =
        "px-3 pt-2 pb-1 text-xs font-medium uppercase tracking-wide text-slate-400";
      $el.textContent = text;
      return $el;
    };

    // Build one selectable row. `activate` runs on click or Enter.
    UnifiedSearch.prototype.addOption = function ($el, activate) {
      const index = this.options.length;
      $el.id = "search-opt-" + index;
      $el.setAttribute("role", "option");
      $el.addEventListener("click", () => activate());
      $el.addEventListener("mousemove", () => this.setActive(index));
      this.options.push({ $el, activate });
      this.$dropdown.appendChild($el);
    };

    UnifiedSearch.prototype.renderDropdown = function () {
      const query = this.$input.value.trim().toLowerCase();
      this.options = [];
      this.activeIndex = -1;
      this.$dropdown.replaceChildren();

      if (!query) {
        this.closeDropdown();
        return;
      }

      const availableSlugs = this.drinksData.filterByIngredients(
        this.selectedIngredients
      );
      const cocktailMatches = this.drinksData.matchCocktails(query, availableSlugs);
      const ingredientMatches = this.drinksData.matchIngredients(
        query,
        this.selectedIngredients
      );

      // Cocktails first (per the chosen design), ingredients second.
      if (cocktailMatches.length > 0) {
        this.$dropdown.appendChild(this.groupHeader("Cocktails"));
        cocktailMatches.forEach((drink) => {
          const $opt = document.createElement("div");
          $opt.className = "opt flex items-center gap-2 px-3 py-2";
          $opt.innerHTML =
            ICON_COCKTAIL +
            '<span class="text-sm text-slate-800 flex-1"></span>' +
            ICON_ARROW;
          $opt.querySelector("span").textContent = drink.drinkTitle;
          this.addOption($opt, () => {
            window.location = drink.drinkUrl;
          });
        });
      }

      if (ingredientMatches.length > 0) {
        this.$dropdown.appendChild(this.groupHeader("Filter by ingredients"));
        ingredientMatches.forEach((ingredient) => {
          const count = (
            this.drinksData.ingredientsToDrinks[ingredient] || []
          ).length;
          const $opt = document.createElement("div");
          $opt.className =
            "opt flex items-center justify-between gap-2 px-3 py-2";

          const $left = document.createElement("div");
          $left.className = "flex items-center gap-2";
          $left.innerHTML =
            ICON_INGREDIENT + '<span class="text-sm text-slate-800"></span>';
          $left.querySelector("span").textContent = ingredient;

          const $tag = document.createElement("span");
          $tag.className = "text-xs text-slate-500";
          $tag.textContent =
            "used in " + count + (count === 1 ? " drink" : " drinks");

          $opt.appendChild($left);
          $opt.appendChild($tag);
          this.addOption($opt, () => this.addIngredient(ingredient));
        });
      }

      if (this.options.length === 0) {
        const $empty = document.createElement("div");
        $empty.className = "px-3 py-2 text-sm text-slate-400";
        $empty.textContent = "No cocktail or ingredient matches";
        this.$dropdown.appendChild($empty);
      }

      this.openDropdown();
    };

    UnifiedSearch.prototype.openDropdown = function () {
      this.$dropdown.style.display = null;
      this.$input.setAttribute("aria-expanded", "true");
    };

    UnifiedSearch.prototype.closeDropdown = function () {
      this.$dropdown.style.display = "none";
      this.$input.setAttribute("aria-expanded", "false");
      this.$input.removeAttribute("aria-activedescendant");
      this.activeIndex = -1;
    };

    // Highlight an option by index, keeping it scrolled into view. -1 clears.
    UnifiedSearch.prototype.setActive = function (index) {
      if (this.options[this.activeIndex]) {
        const $prev = this.options[this.activeIndex].$el;
        $prev.classList.remove("is-active");
        $prev.setAttribute("aria-selected", "false");
      }
      this.activeIndex = index;
      const current = this.options[index];
      if (current) {
        current.$el.classList.add("is-active");
        current.$el.setAttribute("aria-selected", "true");
        current.$el.scrollIntoView({ block: "nearest" });
        this.$input.setAttribute("aria-activedescendant", current.$el.id);
      } else {
        this.$input.removeAttribute("aria-activedescendant");
      }
    };

    UnifiedSearch.prototype.moveActive = function (delta) {
      if (this.options.length === 0) {
        return;
      }
      let next = this.activeIndex + delta;
      if (next < 0) {
        next = this.options.length - 1;
      } else if (next >= this.options.length) {
        next = 0;
      }
      this.setActive(next);
    };

    UnifiedSearch.prototype.onKeyDown = function (event) {
      const open = this.$dropdown.style.display !== "none";
      switch (event.key) {
        case "ArrowDown":
          event.preventDefault();
          if (!open) {
            this.renderDropdown();
          } else {
            this.moveActive(1);
          }
          break;
        case "ArrowUp":
          event.preventDefault();
          if (open) {
            this.moveActive(-1);
          }
          break;
        case "Enter":
          if (open && this.options[this.activeIndex]) {
            event.preventDefault();
            this.options[this.activeIndex].activate();
          }
          break;
        case "Escape":
          if (open) {
            event.preventDefault();
            this.closeDropdown();
          }
          break;
        case "Backspace":
          // Empty field + Backspace removes the last chip, like a native chip input.
          if (this.$input.value === "" && this.selectedIngredients.length > 0) {
            this.removeIngredientAt(this.selectedIngredients.length - 1);
          }
          break;
        default:
          break;
      }
    };

    UnifiedSearch.prototype.addIngredient = function (ingredient) {
      this.selectedIngredients.push(ingredient);
      this.$input.value = "";
      this.renderChips();
      this.renderResults();
      this.renderDropdown();
      this.$input.focus();
    };

    UnifiedSearch.prototype.removeIngredientAt = function (index) {
      this.selectedIngredients.splice(index, 1);
      this.renderChips();
      this.renderResults();
      this.renderDropdown();
    };

    UnifiedSearch.prototype.init = function () {
      this.$input.addEventListener("input", () => this.renderDropdown());
      this.$input.addEventListener("keydown", (event) => this.onKeyDown(event));
      this.$box.addEventListener("click", () => this.$input.focus());
      document.addEventListener("click", (event) => {
        if (!event.target.closest("#search-area")) {
          this.closeDropdown();
        }
      });
    };

    const drinksData = new DrinksData();
    const drinksList = new DrinksList();
    const search = new UnifiedSearch(drinksData, drinksList);
    search.init();
  })();
</script>
{% endblock %}
